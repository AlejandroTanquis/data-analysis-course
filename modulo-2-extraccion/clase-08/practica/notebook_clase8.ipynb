   "source": [
    "import sqlite3\n",
    "import pandas as pd\n",
    "\n",
    "conexion = sqlite3.connect(\"ventas.db\")\n",
    "\n",
    "df = pd.read_sql(\n",
    "    \"SELECT * FROM productos\",\n",
    "    conexion\n",
    ")\n",
    "\n",
    "print(df.shape)"
   ]
